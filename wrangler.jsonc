{
  // Schema lives on unpkg because this repo has no node_modules.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "baskingspot-dev-testingx",
  // Set to the date of the last deploy-relevant config change.
  "compatibility_date": "2026-10-18",
  // Pure static site: no worker script, so no `main` and no `binding`.
  "assets": {
    // The guide under /testingx/ (see justfile `doc`). The router in
    // baskingspot/site forwards /testingx/... without stripping the prefix,
    // so the Worker sees the paths as built.
    "directory": "./zig-out/site",
    // Plain 404 for unknown paths (not an SPA, no 404.html).
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
  },
  "workers_dev": false,
  "preview_urls": false,
}
